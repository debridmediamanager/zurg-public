[Unit]
Description=Rclone mount for zurg
After=network-online.target zurg.service
Wants=network-online.target
Requires=zurg.service

# Adjust User, the rclone.conf path and the mountpoint to your install.
# The paths below assume /opt/zurg owned by a "zurg" user.
#
# install rclone with:
#   sudo -v ; curl https://rclone.org/install.sh | sudo bash
#
# create the mountpoint first:
#   sudo mkdir -p /mnt/zurg && sudo chown zurg:zurg /mnt/zurg
#
# Mounted files are owned by the user this runs as. If Plex or Jellyfin runs
# as a different user and needs a specific owner, add --uid=<n> --gid=<n>.

[Service]
Type=notify
User=zurg
Group=zurg
ExecStart=/usr/bin/rclone mount zurg: /mnt/zurg \
  --config=/opt/zurg/rclone.conf \
  --log-level=INFO \
  --log-file=/var/log/rclone-zurg.log \
  --allow-non-empty \
  --allow-other \
  --attr-timeout 10y \
  --dir-cache-time 60s \
  --poll-interval 30s \
  --vfs-cache-mode full \
  --vfs-refresh \
  --vfs-read-chunk-size 2M \
  --vfs-read-chunk-size-limit 64M \
  --buffer-size 128M \
  --vfs-read-ahead 128M \
  --vfs-cache-poll-interval 30s \
  --vfs-fast-fingerprint \
  --vfs-cache-max-age 2M \
  --vfs-cache-max-size 100G \
  --vfs-cache-min-free-space 1G \
  --vfs-disk-space-total-size 1T \
  --transfers 16 \
  --checkers 16 \
  --multi-thread-streams 4 \
  --vfs-read-wait 40ms \
  --cache-dir=/opt/rclone/cache/zurg

# Unmount cleanly on stop
ExecStop=/bin/bash -c '/bin/fusermount -uz /mnt/zurg || umount /mnt/zurg'

Restart=always
RestartSec=5

StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
