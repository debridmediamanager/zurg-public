[Unit]
Description=zurg
After=network-online.target
Wants=network-online.target

# Adjust User, WorkingDirectory and ExecStart to wherever you unpacked zurg.
# The paths below assume /opt/zurg owned by a "zurg" user:
#   sudo useradd --system --home-dir /opt/zurg --shell /usr/sbin/nologin zurg
#   sudo mkdir -p /opt/zurg && sudo chown -R zurg:zurg /opt/zurg

[Service]
Type=simple
User=zurg
Group=zurg
WorkingDirectory=/opt/zurg
ExecStart=/opt/zurg/zurg -c /opt/zurg/config.yml
StandardOutput=append:/var/log/zurg.log
StandardError=append:/var/log/zurg.log
Restart=on-failure
RestartSec=1
StartLimitInterval=600s
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
